# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Identity: HMAC JWT for local/dev. Replace with OIDC in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=authinject-rag
JWT_AUDIENCE=authinject-rag-api
JWT_EXPIRE_MINUTES=480

# SpiceDB (required unless APP_ENV=test)
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_PRESHARED_KEY=foobar
SPICEDB_FAIL_CLOSED=true

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=authinject_chunks
QDRANT_IN_MEMORY=false

# OpenAI-compatible LLM (local DeepSeek / vLLM / Ollama)
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
LLM_FAIL_CLOSED=true

# Embeddings: gemini | hash (hash is for tests / offline)
EMBED_BACKEND=gemini
GOOGLE_API_KEY=
EMBED_MODEL=models/gemini-embedding-001
EMBED_DIM=768

# Guardrails
ENABLE_INDIRECT_INJECTION_SCAN=true
ENABLE_CONTEXT_ISOLATION=true
ENABLE_DATAMARKING=true
ENABLE_LLM_INJECTION_SCAN=true
ENABLE_ACTION_AUTHZ=true
ENABLE_TASK_ALIGNMENT=false
MAX_AGENT_STEPS=2
MAX_LLM_CALLS=12

# Optional PII customisation
PRESIDIO_CUSTOM_DENY_LIST=
PRESIDIO_CUSTOM_PATTERNS=

# Audit
AUDIT_LOG_PATH=logs/audit.jsonl
